<Window x:Class="FinanceTracker.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FinanceTracker — личные финансы" Width="1180" Height="780" MinWidth="1020" MinHeight="680"
 WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,20">
   <StackPanel><TextBlock Text="FinanceTracker" FontSize="28" FontWeight="Bold"/>
    <TextBlock Text="Доходы, расходы и бюджет · суммы в рублях" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button x:Name="ThemeButton" Click="Theme_Click" Content="Тёмная тема"/>
    <Button Click="Demo_Click" Content="Демо-данные" ToolTip="8 операций и бюджет; только для пустого файла"/>
    <Button Click="Help_Click" Content="Справка · F1" Margin="0"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,16">
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,12,0">
    <StackPanel><TextBlock Text="Доходы за месяц" Foreground="{DynamicResource MutedBrush}"/>
     <TextBlock x:Name="IncomeText" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource IncomeBrush}" Margin="0,8,0,0"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="18" Margin="0,0,12,0">
    <StackPanel><TextBlock Text="Расходы за месяц" Foreground="{DynamicResource MutedBrush}"/>
     <TextBlock x:Name="ExpenseText" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource ExpenseBrush}" Margin="0,8,0,0"/>
    </StackPanel>
   </Border>
   <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="18">
    <StackPanel><TextBlock Text="Остаток за месяц" Foreground="{DynamicResource MutedBrush}"/>
     <TextBlock x:Name="BalanceText" FontSize="28" FontWeight="SemiBold" Margin="0,8,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <TextBlock Text="Бюджет месяца" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <TextBox x:Name="BudgetInput" Width="120" ToolTip="Пусто — убрать бюджет; 0 — запрет расходов"/>
     <Button Content="Сохранить" Click="Budget_Click" Margin="10,0,0,0"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
     <TextBlock x:Name="BudgetStatus" Margin="0,0,0,8"/>
     <ProgressBar x:Name="BudgetProgress" Height="7" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}"/>
    </StackPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="3">
   <Grid Margin="0,0,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="155"/><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
     <Button Content="‹" Click="PreviousMonth_Click" Padding="10,5" ToolTip="Предыдущий месяц"/>
     <TextBox x:Name="MonthInput" Width="95" ToolTip="Месяц yyyy-MM; нажмите Enter"/>
     <Button Content="›" Click="NextMonth_Click" Padding="10,5" Margin="8,0,0,0" ToolTip="Следующий месяц"/>
    </StackPanel>
    <ComboBox Grid.Column="1" x:Name="KindFilter" Margin="0,0,12,0" SelectionChanged="Filter_Changed" SelectedIndex="0" ToolTip="Вид операции">
     <ComboBoxItem Content="Все виды"/><ComboBoxItem Content="Доходы"/><ComboBoxItem Content="Расходы"/>
    </ComboBox>
    <ComboBox Grid.Column="2" x:Name="CategoryFilter" Margin="0,0,12,0" SelectionChanged="Filter_Changed" ToolTip="Категория"/>
    <TextBox Grid.Column="3" x:Name="SearchInput" TextChanged="Search_Changed" ToolTip="Поиск по категории и комментарию"/>
   </Grid>
   <DockPanel Margin="0,0,0,12">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
     <Button Content="+ Добавить" Click="Add_Click" Background="{DynamicResource AccentBrush}" Foreground="White" ToolTip="Ctrl+N"/>
     <Button Content="Изменить" Click="Edit_Click" ToolTip="Ctrl+E или двойной щелчок по строке"/>
     <Button Content="Удалить" Click="Delete_Click" ToolTip="Delete в таблице"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
     <Button Content="Сброс фильтров" Click="Reset_Click"/>
     <Button Content="Обновить" Click="Reload_Click" ToolTip="Ctrl+R"/>
     <Button Content="Экспорт CSV" Click="Export_Click" ToolTip="Ctrl+Shift+E: экспорт видимого списка" Margin="0"/>
    </StackPanel>
   </DockPanel>
  </StackPanel>
  <Border Grid.Row="4" Background="{DynamicResource PanelBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
   <Grid>
    <DataGrid x:Name="TransactionsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
     CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
     Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="0"
     RowBackground="{DynamicResource PanelBrush}" AlternatingRowBackground="{DynamicResource RowAltBrush}"
     MouseDoubleClick="Grid_DoubleClick">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="120"/>
      <DataGridTextColumn Header="Вид" Binding="{Binding TypeLabel}" Width="100"/>
      <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Amount, StringFormat=N2}" Width="145"/>
      <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="170"/>
      <DataGridTextColumn Header="Комментарий" Binding="{Binding Note}" Width="*"/>
      <DataGridTextColumn Header="ID" Binding="{Binding ShortId}" Width="105"/>
     </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="EmptyMessage" Text="Операций пока нет. Добавьте запись или загрузите демо-данные." HorizontalAlignment="Center" VerticalAlignment="Center"
     Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/>
   </Grid>
  </Border>
  <StackPanel Grid.Row="5" Margin="0,12,0,0">
   <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}"/>
   <TextBlock x:Name="DataPathText" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
  </StackPanel>
 </Grid>
</Window>
